/* Crash Javascript */

/* global
     quiet:
       writable */

const
  _libcrash =
    require(
      "crash-js");
const
  _cmdline_check =
    _libcrash._cmdline_check;
const
  _echo =
    _libcrash._echo;
const
  _error_display =
    _libcrash._error_display;
const
  _file_write =
    _libcrash._file_write;
const
  _file_exists =
    _libcrash._file_exists;
const
  _msg_info =
    _libcrash._msg_info;
const
  _msg_error =
    _libcrash._msg_error;
const
  _process_exit =
    _process_exit;
const
  _check_module =
    require(
      "./evmfs.js.check");
const
  _check =
    _check_module._check;
const
  _chunk_file_path_check =
    _file_exists;

function
  _global_variables() {
  /* global
       app_name */
  app_name =
    "evmfs.js.verify";
  /* global
       retries_max:
         writable */
  retries_max =
    "";
  /* global
       api_key_path:
         writable */
  api_key_path =
    "";
  /* global
       target_network:
         writable */
  target_network =
    "";
  /* global
       contract_address:
         writable */
  contract_address =
    "";
  /* global
       contract_abi_path:
         writable */
  contract_abi_path =
    "";
  /* global
       contract_bytecode_path:
         writable */
  contract_bytecode_path =
    "";
  /* global
       contract_compiler_output_path:
         writable */
  contract_compiler_output_path =
    "";
  /* global
       method_object:
         writable */
  method_object =
    "";
  /* global
       publication_namespace:
         writable */
  publication_namespace =
    "";
  /* global
       file_hash:
         writable */
  file_hash =
    "";
  /* global
       checkpoint_file_path:
         writable */
  checkpoint_file_path =
    "";
  /* global
       chunks_file_path_prefix:
         writable */
  chunks_file_paths_prefix =
    ""
  /* global
       chunks_indexes:
         writable */
  chunks_indexes =
    [];
  quiet =
    "";
}

function
  _msg_info_chunk_verify(
    _index,
    _progress,
    _total) {
  const
    _msg =
      "Verifying chunk " +
      `'${_index}' ('${_progress}' ` +
      `of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _msg_info_chunk_verified(
    _index,
    _progress,
    _total) {
  const
    _msg =
      `Verified chunk '${_index}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _msg_error_chunk_corrupted(
    _index,
    _chunk_file_path,
    _progress,
    _total) {
  const
    _msg =
      `Chunk '${_index}' at ` +
      `location '${_chunk_file_path}' ` +
      `corrupted ('${_progress}' ` +
      `of '${_total}').`;
  _msg_error(
    _msg,
    1)
}

function
  _chunk_file_path_get(
    _prefix,
    _index) {
  const
    _chunk_no =
      _index + 1;
  const
    _path =
      _prefix.concat(
        `.${_chunk_no}`);
  return _path;
}

async function
  _verify(
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _publication_namespace,
    _file_hash,
    _checkpoint_file_path,
    _chunks_files_paths_prefix,
    _chunks_indexes
  ) {
  let
    _check_opts,
    _chunk,
    _chunk_file_path,
    _chunks_checked,
    _chunks_checked_total,
    _chunks_corrupted,
    _chunks_total,
    _correct,
    _index,
    _msg,
    _progress;
  if ( _method_object == undefined ) {
    _method_object =
      "";
  }
  _chunks_checked =
    [];
  _chunks_corrupted =
    [];
  _chunks_total =
    _chunks_indexes.length;
  for ( var _cursor = 0;
        _cursor < _chunks_total;
        _cursor++ ) {
    _progress =
      _cursor + 1;
    _index =
      Number(
        _chunks_indexes[
          _cursor]);
    _msg_info_chunk_verify(
      _index,
      _progress,
      _chunks_total);
    if ( _index == 0 &&
         _chunks_total == 1 ) {
      _chunk_file_path =
        _chunks_files_paths_prefix;
    }
    else {
      _chunk_file_path =
        _chunk_file_path_get(
          _chunks_files_paths_prefix,
          _index);
    }
    _chunk_file_path_check(
      _chunk_file_path);
    _check_opts = [
      _retries_max,
      _api_key_path,
      _target_network,
      _contract_address,
      _contract_abi_path,
      _contract_bytecode_path,
      _contract_compiler_output_path,
      _method_object,
      _publication_namespace,
      _file_hash,
      _index,
      _index,
      [ _chunk_file_path ]
    ];
    try {
      [_chunks_checked,
       _method_object] =
        await _check.apply(
	  null,
          _check_opts);
          // _retries_max,
          // _api_key_path,
          // _target_network,
          // _contract_address,
          // _contract_abi_path,
          // _contract_bytecode_path,
          // _contract_compiler_output_path,
          // _method_object,
          // _publication_namespace,
          // _file_hash,
          // _index,
          // _index,
          // [_chunk_file_path]); 
      if ( _check_opts[7] == "" ) {
        _msg_info(
          "Reusing contract method object.");
        // I have no idea if _check_call_base_opts
        // has its components passed by reference
        // or copied so I have no idea if
        // _method_object gets immediately updated
        // or I need to re-init the array so just
        // in case we re-init whole array.
        _check_opts = [
          _retries_max,
          _api_key_path,
          _target_network,
          _contract_address,
          _contract_abi_path,
          _contract_bytecode_path,
          _contract_compiler_output_path,
          _method_object,
          _publication_namespace,
          _file_hash,
          _index,
          _index,
          [_chunk_file_path]
        ];
      }
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error running check routine.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _chunks_checked_total =
      _chunks_checked.length;
    if ( _chunks_checked_total == 1 ) {
      if ( _chunks_checked[0] == true ) {
        _file_write(
          _checkpoint_file_path,
          _index.toString());
      }
      else if ( _chunks_checked[0] == false ) {
        _msg =
          `Chunk with index ${_index.toString()} ` +
	  `has not been published.`;
        throw _msg
      }
    }
    else if ( _chunks_checked_total == 0 ) {
      // Temporary
      _msg_error_chunk_corrupted(
        _index,
        _chunk_file_path,
        _progress,
        _chunks_total);
      // Soon
      _chunks_corrupted.push(
        _index);
      throw "Some chunks have not been published."
    }
  }
  return [
    _chunks_corrupted,
    _method_object];
}

function
  _config_show() {
  let
    _line;
  const
    _chunks_indexes =
      chunks_indexes.join(
      " ");
  const
    _text = [
      `          Maximum retries: ${retries_max}`,
      `                  API Key: ${api_key_path}`,
      `           Target network: ${target_network}`,
      `         Contract address: ${contract_address}`,
      `             Contract ABI: ${contract_abi_path}`,
      `        Contract bytecode: ${contract_bytecode_path}`,
      ` Contract compiler output: ${contract_compiler_output_path}`,
      `    Publication namespace: ${publication_namespace}`,
      `                File hash: ${file_hash}`,
      `     Checkpoint file path: ${checkpoint_file_path}`,
      `Chunks files paths prefix: ${chunks_files_paths_prefix}`,
      `           Chunks indexes: ${_chunks_indexes}`,
    ];
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

function
  _usage(
    _exit) {
  let
    _line,
    _text;
  _text = [
    "Verify published chunks of an EVMFS file.",
    "",
    "Usage:",
    "  evmfs.js.verify",
    "    <quiet>",
    "    <retries-max>",
    "    <api-key-path>",
    "    <target-network>",
    "    <contract-address>",
    "    <contract-abi-path>",
    "    <contract-bytecode-path>",
    "    <contract-compiler-output-path>",
    "    <publication-namespace>",
    "    <file-hash>",
    "    <checkpoint-file-path>",
    "    <chunks-files-paths-prefix>",
    "    [chunks-indexes]",
    "",
    "Args:",
    "  <quiet>                          Can be 'y' or 'n'",
    "                                   Default: y",
    "  <retries-max>                    Maximum number of retries before",
    "                                   failing (not implemented).",
    "  <api-key-path>                   Path of the API key for the",
    "                                   contract ABI provider service.",
    "  <target-network>                 Network on which the contract",
    "                                   resides.",
    "  <contract-address>               Address of the contract.",
    "  <contract-abi-path>              Contract ABI path.",
    "  <contract-bytecode-path>         Path for the contract bytecode.",
    "  <contract-compiler-output-path>  Path for the contract compiler",
    "                                   output path (the hardhat artifact).",
    "  <publication-namespace>          Namespace in which the file will be",
    "                                   published.",
    "  <file-hash>                      Hash of the file to publish.",
    "  <checkpoint-file-path>           Checkpoint file on which latest",
    "                                   downloaded chunk index is saved",
    "                                   in case node was to crash.",
    "  <chunks-files-paths-prefix>      Chunks files paths prefix.",
    "  [chunks-indexes]                 Indexes of the chunks to verify.",
  ];
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
  _process_exit(
    _exit);
}

function 
  _cmdline_parse() {
  quiet = 
    "y";
  process.argv.forEach(
    function (
      _value,
      _index,
      _array) {
      if ( _index == 2 ) {
        quiet =
          _value;
      }
      if ( _index == 3 ) {
        retries_max =
          _value;
      }
      if ( _index == 4 ) {
        api_key_path =
          _value;
      }
      if ( _index == 5 ) {
        target_network =
          _value;
      }
      if ( _index == 6 ) {
        contract_address =
          _value;
      }
      if ( _index == 7 ) {
        contract_abi_path =
          _value;
      }
      if ( _index == 8 ) {
        contract_bytecode_path =
          _value;
      }
      if ( _index == 9 ) {
        contract_compiler_output_path =
          _value;
      }
      if ( _index == 10 ) {
        publication_namespace =
          _value;
      }
      if ( _index == 11 ) {
        file_hash =
          _value;
      }
      if ( _index == 12 ) {
        checkpoint_file_path =
          _value;
      }
      if ( _index == 13 ) {
        chunks_files_paths_prefix =
          _value;
      }
      if ( 13 < _index ) {
	chunks_indexes.push(
          _value);
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _usage(
          0);
      }
  });
  if ( file_hash == "" ||
       publication_namespace == "" ) {
    _usage(
      1);
  }
}

async function
  _verify_cmdline(
    _app_opts) {
  let
    _chunks_corrupted,
    _index,
    _method_object;
  [ _chunks_corrupted,
    _method_object ] = 
    await _verify.apply(
      null,
      _app_opts);
  for ( _index of _chunks_corrupted ) {
    _echo(
      _index.toString());
  }
}

if ( _cmdline_check(
       "evmfs.js.verify") ) {
  _global_variables();
  _cmdline_parse();
  _config_show();
  app_opts = [
    retries_max,
    api_key_path,
    target_network,
    contract_address,
    contract_abi_path,
    contract_bytecode_path,
    contract_compiler_output_path,
    method_object,
    publication_namespace,
    file_hash,
    checkpoint_file_path,
    chunks_files_paths_prefix,
    chunks_indexes,
  ];
  _verify_cmdline(
    app_opts);
}

module.exports = {
  _verify:
    _verify
};
