  _libevm_module =
    await _require(
      "libevm");
const
  _deployments_dir_check =
    _libevm_module._deployments_dir_check;

function
  _call_timeout_auto_detect() {
  let
    _call_timeout;
  const
    _target_command =
      _get(
        "target",
        "command");
  if ( _target_command == "get" ) {
    _call_timeout =
      3000;
  }
  else if ( _target_command == "publish" ) {
    _call_timeout =
      60000;
  }
  else {
    _msg =
      `Unknown command '${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  _override_set(
    "call",
    "timeout",
    _call_timeout)
}

function
  _call_auth_auto_detect() {
  let
    _call_auth;
  const
    _target_command =
      _get(
        "target",
        "command");
  if ( _target_command == "get" ) {
    _call_auth =
      "n";
  }
  else if ( _target_command == "publish" ) {
    _call_auth =
      "y";
  }
  else {
    _msg =
      `Unknown command '${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  _override_set(
    "call",
    "auth",
    _call_auth)
}

async function
  _deployments_dir_auto_detect(){
  let
    _deployments_dir,
    _msg,
    _user_level;
  const
    _app_name =
      "evmfs";
  _user_level =
    _get(
      "user",
      "level");
  _deployments_dir =
    _get(
      "deployments",
      "dir");
  const
    _deployments_dir_check_args = [
      _deployments_dir,
      _app_name,
      _user_level
    ];
  try {
    _deployments_dir =
      await _deployments_dir_check.apply(
        null,
        _deployments_dir_check_args);
    _msg =
      "Auto-detected deployments directory " +
      `'${_deployments_dir}'.`;
    _msg_info(
      _msg);
  }
  catch(
    _error) {
    const
      _msg =
        "Error running '_deployments_dir_check' " +
        `with arguments '${_deployments_dir_check_args}':`;
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  _override_set(
    "deployments",
    "dir",
    _deployments_dir);
}

function
  _parallel_tasks_auto_detect() {
  let
    _parallel_tasks;
  const
    _target_command =
      _get(
        "target",
        "command");
  if ( _target_command == "get" ) {
    _parallel_tasks =
      1;
  }
  else if ( _target_command == "publish" ) {
    _parallel_tasks =
      1;
  }
  else {
    _msg =
      `Unknown command '${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  _override_set(
    "parallel",
    "tasks",
    _parallel_tasks)
}

async function
  _evmfs(
    _target_command,
    _target_key,
    _target_value) {
  let
    _msg;
  _msg =
    `Running command ` +
    `'${_target_command}' with key ` +
    `'${_target_key}' and value` +
    `'${_target_value}'.`;
  _msg_info(
    _msg);
  _msg =
    "mm mm.";
  _msg_info(
    _msg);
  const
    _results =
      ["ciao"];
  return _results;
}

