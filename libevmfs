async function
  _evmfs(
    _target_command,
    _target_key,
    _target_value) {
  let
    _msg;
  _msg =
    `Running command ` +
    `'${_target_command}' with key ` +
    `'${_target_key}' and value` +
    `'${_target_value}'.`;
  _msg_info(
    _msg);
  _msg =
    "mm mm.";
  _msg_info(
    _msg);
}

// ES6 module export

