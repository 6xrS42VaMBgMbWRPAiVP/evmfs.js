const
  _libcrash =
    await import(
      "libcrash-js");
/* global
     _get */
const
  _get =
    _libcrash._get;
/* global
     _msg_info */
const
  _msg_info =
    _libcrash._msg_info;
/* global
     _override_set */
const
  _override_set =
    _libcrash._override_set;

const
  _common_module =
    await import(
      "./lib/common");
const
  _check_module =
    await import(
      "./lib/check");
const
  _ccget_module =
    await import(
      "./lib/ccget");
const
  _get_module =
    await import(
      "./lib/get");
const
  _index_module =
    await import(
      "./lib/index");
const
  _lengthlock_module =
    await import(
      "./lib/lengthlock");
const
  _lock_module =
    await import(
      "./lib/lock");
const
  _publish_module =
    await import(
      "./lib/publish");
const
  _publish_bulk_module =
    await import(
      "./lib/publish_bulk");
const
  _verify_module =
    await import(
      "./lib/verify");

function
  _call_timeout_auto_detect() {
  let
    _call_timeout;
  const
    _target_command =
      _get(
        "target",
        "command");
  if ( _target_command == "get" ) {
    _call_timeout =
      3000;
  }
  else if ( _target_command == "publish" ) {
    _call_timeout =
      60000;
  }
  else {
    _msg =
      `Unknown command '${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  _override_set(
    "call",
    "timeout",
    _call_timeout)
}

function
  _call_auth_auto_detect() {
  let
    _call_auth;
  const
    _target_command =
      _get(
        "target",
        "command");
  if ( _target_command == "get" ) {
    _call_auth =
      "n";
  }
  else if ( _target_command == "publish" ) {
    _call_auth =
      "y";
  }
  else {
    _msg =
      `Unknown command '${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  _override_set(
    "call",
    "auth",
    _call_auth)
}

async function
  _evmfs(
    _target_command,
    _target_key,
    _target_value) {
  let
    _msg;
  _msg =
    `Running command ` +
    `'${_target_command}' with key ` +
    `'${_target_key}' and value` +
    `'${_target_value}'.`;
  _msg_info(
    _msg);
  _msg =
    "mm mm.";
  _msg_info(
    _msg);
  const
    _results =
      ["ciao"];
  return _results;
}

// ES6 module export

export {
  _call_auth_auto_detect,
  _call_timeout_auto_detect,
  _common_module,
  _ccget_module,
  _check_module,
  _evmfs,
  _index_module,
  _lengthlock_module,
  _lock_module,
  _get_module,
  _publish_module,
  _publish_bulk_module,
  _verify_module,
};

