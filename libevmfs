async function
  _contracts_auto_detect() {
  let
    _contract_setup_auto_detect_args,
    _msg;
  const
    _contract_version =
      _get(
        "contract",
        "version");
  const
    _target_networks =
      _get(
        "target",
        "networks");
  const
    _configuration_format =
      _get(
        "configuration",
        "format");
  const
    _target_network =
      _target_networks[
        0];
  const
    _user_level =
      _get(
        "user",
        "level");
  const
    _deployments_dir =
      _get(
        "deployments",
        "dir");
  const
    _contracts_package =
      "evmfs-contracts";
  _contract_setup_auto_detect_args = [
    "evmfs",                  // application name
    "FileSystem",             // contract name
    "fs",                     // contract short name
    _contract_version,
    _target_network,
    _user_level,
    _deployments_dir,
    _contracts_package,
    _configuration_format
  ];
  try {
    await _contract_setup_auto_detect.apply(
      null,
      _contract_setup_auto_detect_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_contract_setup_auto_detect' " +
      "with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  _contract_setup_auto_detect_args = [
    "evmfs",                  // application name
    "CrossChainFileSystem",   // contract name
    "fs",                     // contract short name
    _contract_version,
    _target_network,
    _user_level,
    _deployments_dir,
    _contracts_package,
    _configuration_format
  ];
  try {
    await _contract_setup_auto_detect.apply(
      null,
      _contract_setup_auto_detect_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_contract_setup_auto_detect' " +
      "with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
}

async function
  _evmfs(
    _target_command,
    _target_key,
    _target_value) {
  let
    _msg;
  _msg =
    `Running command ` +
    `'${_target_command}' with key ` +
    `'${_target_key}' and value` +
    `'${_target_value}'.`;
  _msg_info(
    _msg);
  _msg =
    "mm mm.";
  _msg_info(
    _msg);
  const
    _results =
      ["ciao"];
  return _results;
}

